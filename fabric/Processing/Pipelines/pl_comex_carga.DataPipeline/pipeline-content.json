                },
                "sink": {
                  "name": "year",
                  "type": "String"
                }
              },
              {
                "source": {
                  "path": "['monthNumber']"
                },
                "sink": {
                  "name": "monthNumber",
                  "type": "String"
                }
              },
              {
                "source": {
                  "path": "['metricFOB']"
                },
                "sink": {
                  "name": "metricFOB",
